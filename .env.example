# Kopiraj ovaj file u `.env` u istom direktoriju kao pubspec.yaml.
# U `.env` zamijeni placeholder stvarnim API ključem (ne commitaj .env).
#
# Google Cloud Console → APIs & Services → Credentials → Create API key
# Obavezno uključi "Maps SDK for Android" za taj ključ (i ograničenja po paketu).

GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
